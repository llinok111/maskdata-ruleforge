{
  "name": "maskdata",
  "version": "1.3.4-ruleforge.1",
  "private": true,
  "description": "Node module to mask various kinds of data in the required formats. Fork adding a declarative, validated, ordered rule layer (maskJSON3) on top of the unmodified maskJSON2 API.",
  "main": "index.js",
  "typings": "index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sumukha1496/maskdata"
  },
  "homepage": "https://github.com/llinok111/maskdata-ruleforge#readme",
  "bugs": {
    "url": "https://github.com/llinok111/maskdata-ruleforge/issues"
  },
  "scripts": {
    "test": "mocha tests/test*.js --timeout 5000 --exit",
    "test:rules": "mocha tests/testRules.js tests/testMigration.js --timeout 5000 --exit",
    "examples": "node examples/run-examples.js",
    "coverage": "nyc --reporter=html --reporter=text npm run test",
    "format": "prettier --write '**/*.{ts,js,json}'",
    "typecheck": "tsc -p types-check/tsconfig.json"
  },
  "keywords": [
    "mask",
    "data",
    "datamask",
    "maskdata",
    "hide data",
    "mask data",
    "mask sensitive",
    "mask password",
    "mask card",
    "mask json",
    "mask string",
    "mask object",
    "mask json",
    "recursive mask json",
    "Get json fields",
    "Set json fields",
    "Replcae json fields",
    "email",
    "phone",
    "uuid",
    "string",
    "sensitive",
    "JWT",
    "jwt mask",
    "jwt token",
    "token"
  ],
  "author": "sumukha.hs<sumukha.hs369@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "lodash": "^4.17.23"
  },
  "devDependencies": {
    "chai": "^4.3.10",
    "mocha": "^10.2.0",
    "mocha-junit-reporter": "^2.2.1",
    "nyc": "^17.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
